{
  "compilerOptions": {
    "incremental": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "strict": true,
    "moduleResolution": "bundler",  // ← was "node", bundler matches tsup/esbuild
    "target": "esnext",
    "module": "esnext",
    "moduleDetection": "force",     // ← add this
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}